#usda 1.0
(
    defaultPrim = "Floor"
    doc = "Procedural floor slab: 6 x 6 m, 100 mm thick, top face at z = 0. Kitchen frame: centred on the origin, z up. Generated by scripts/make_counter_usd.py; do not edit by hand."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Floor"
{
    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1
        float physics:restitution = 0
        float physics:staticFriction = 1
    }

    def Cube "Slab" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding:physics = </Floor/PhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        color3f[] primvars:displayColor = [(0.45, 0.45, 0.47)]
        double size = 1
        double3 xformOp:scale = (6, 6, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

