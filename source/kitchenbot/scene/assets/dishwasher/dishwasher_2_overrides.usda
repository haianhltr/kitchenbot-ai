#usda 1.0
(
    defaultPrim = "Dishwasher"
    doc = "Overrides for ArtVIP dishwasher_2 (#59): references the git-ignored ArtVIP file, puts the articulation root link E_body_5 at the origin, sets convexDecomposition on the racks and convexHull on the body and door, removes the ArtVIP behaviour script, door open 90 deg, lower rack limits -0.2..0 m and target -0.2 m. Generated by scripts/make_dishwasher_overrides.py --rack-travel 0.2; do not edit by hand."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Dishwasher"
{
    def Xform "ArtVIP" (
        prepend references = @../third_party/artvip/Articulated_objects/major_appliances/dishwasher/dishwasher_2/model_dishwasher_2.usda@
    )
    {
        double3 xformOp:translate = (0.2364634, 0.2022152, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "E_body_5" (
            delete apiSchemas = ["OmniScriptingAPI"]
        )
        {
            uniform asset[] omni:scripting:scripts = []

            over "P_c4698ba0b0ef07e2" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "P_63d8aef9c4af07e2" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "P_f7a07bce31ef07e2" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "P_7b637ac7626f07e2" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "P_75a52a7e554207e2" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "E_composite_1"
            {
                over "P_a56573c2ba5b55d3" (
                    delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "convexHull"
                }

                over "P_13f95c09b3dfeed8" (
                    delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "convexHull"
                }

                over "P_c578ff39705a2ed8" (
                    delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "convexHull"
                }
            }
        }

        over "E_door_4"
        {
            over "P_1eb2d8bb09b410d8" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "P_51065ed96c8f07e2" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "handle"
            {
                over "P_4ab085662d6b07e2" (
                    delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "convexHull"
                }
            }

            over "RevoluteJoint_dishwasher_2_middle"
            {
                float drive:angular:physics:targetPosition = 90
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
            }
        }

        over "E_shelf_03"
        {
            over "P_1440b71c964e2ed8" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexDecomposition"
            }
        }

        over "E_shelf_1_04"
        {
            over "P_23f8dca1790b2ed8" (
                delete apiSchemas = ["PhysxSDFMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexDecomposition"
            }

            over "PrismaticJoint_dishwasher_2_down"
            {
                float drive:linear:physics:targetPosition = -0.2
                float physics:lowerLimit = -0.2
                float physics:upperLimit = 0
            }
        }
    }
}

